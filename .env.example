# EchoCount Runtime Environment Variables (copy to .env for local use; NEVER commit .env)
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Production vs Developer mode (keep 0 in production; 1 enables local dataset ground-truth lookup)
ECHOCOUNT_DEV=0

# Upload & job limits
MAX_UPLOAD_BYTES=41943040
MAX_DURATION_SECONDS=600
JOB_TTL_SECONDS=1800
RATE_LIMIT_PER_MINUTE=120
SEPARATION_WORKERS=2
MC_PASSES=30

# Optional override for checkpoint hosting URL used by scripts/download_models.py
ECHOCOUNT_CHECKPOINT_URL=https://github.com/25-f2001239/Sanada/releases/download/v1.0.0
