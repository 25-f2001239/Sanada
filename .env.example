# EchoCount Runtime Environment Variables (copy to .env or run: python scripts/setup_auth.py)
# NEVER commit .env to Git!
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Production vs Developer mode
# Keep ECHOCOUNT_ENV=production in live deployments (enforces strong SECRET_KEY, single ADMIN_EMAILS, real mail provider).
ECHOCOUNT_ENV=development
ECHOCOUNT_DEV=0
# Show reference ground-truth tab to non-admin users (0 = admin only, 1 = public)
GROUND_TRUTH_PUBLIC=0

# Upload & job limits
MAX_UPLOAD_BYTES=41943040
MAX_DURATION_SECONDS=600
JOB_TTL_SECONDS=1800
RATE_LIMIT_PER_MINUTE=120
SEPARATION_WORKERS=2
MC_PASSES=30

# Optional override for checkpoint hosting URL used by scripts/download_models.py
ECHOCOUNT_CHECKPOINT_URL=https://github.com/25-f2001239/Sanada/releases/download/v1.0.0

# Authentication & Session Security
SECRET_KEY=replace-with-a-long-random-secret-key
ECHOCOUNT_COOKIE_SECURE=0
SESSION_TTL_SECONDS=604800

# Single Locked Administrator (EXACTLY ONE email in production; nobody else can ever become admin via UI/API)
# Roles cannot be changed through the website. Set ADMIN_REQUIRE_OTP=1 to require email OTP on every admin login.
ADMIN_EMAILS=
ADMIN_REQUIRE_OTP=0

# Email OTP Verification (Brevo transactional API — free tier 300/day; recommended)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EchoCount
OTP_DAILY_BUDGET=250


# Optional Google Sign-In (hidden on /login unless configured)
# AUTH_GOOGLE_MODE=authlib (default) or firebase
AUTH_GOOGLE_MODE=authlib
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Firebase Google Sign-In settings (only when AUTH_GOOGLE_MODE=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
