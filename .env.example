# EchoCount Runtime Environment Variables (copy to .env for local use; NEVER commit .env)
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Production vs Developer mode (keep 0 in production; 1 enables local dataset ground-truth lookup)
ECHOCOUNT_DEV=0

# Upload & job limits
MAX_UPLOAD_BYTES=41943040
MAX_DURATION_SECONDS=600
JOB_TTL_SECONDS=1800
RATE_LIMIT_PER_MINUTE=120
SEPARATION_WORKERS=2
MC_PASSES=30

# Optional override for checkpoint hosting URL used by scripts/download_models.py
ECHOCOUNT_CHECKPOINT_URL=https://github.com/25-f2001239/Sanada/releases/download/v1.0.0

# Authentication & Session Security
SECRET_KEY=replace-with-a-long-random-secret-key
ECHOCOUNT_COOKIE_SECURE=0
SESSION_TTL_SECONDS=604800
ECHOCOUNT_ALLOWED_DOMAINS=

# Optional Permanent Administrator Account Provisioning
ECHOCOUNT_ADMIN_EMAIL=
ECHOCOUNT_ADMIN_PASSWORD=
# Comma-separated emails that are always admins (works with Google/OAuth too)
ECHOCOUNT_ADMIN_EMAILS=

# OAuth 2.0 / OIDC Providers (Google, Microsoft, Yahoo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Optional SMTP for email verification and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@echocount.local
