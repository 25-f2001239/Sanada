# Virtual environments
.venv/
venv/
env/
ENV/

# Python caches, test & lint caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.pip-cache/
.pip-tmp/
*.egg-info/

# Node & IDEs
node_modules/
.idea/
.vscode/
*.swp
*.swo

# OS & logs
.DS_Store
Thumbs.db
Desktop.ini
*.log
logs/

# Secrets, environment & local config (keep .env.example)
.env
.env.*
!.env.example
!.env.template
config.local.json
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
secrets.json
service-account*.json

# Databases, SQL dumps & backups
*.db
*.sqlite
*.sqlite3
*.db-*
*.sqlite-*
*.sqlite3-*
*.sql
*.dump
*.bak
*.orig
instance/
data/.secret_key
data/ground_truth_index.json

# Runtime uploads, temp, work, outputs, screenshots & archives
uploads/
user_uploads/
jobs/
tmp/
temp/
work/
feature_cache/
deliverables/
dist/
build/
.cache/
outputs/
screenshots/
playwright-report/
test-results/
backup-*/
cleanup-trash/
expo-demo-frozen/
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Audio files & binary weights (keep single synthetic test tone fixture)
*.wav
*.flac
*.mp3
*.m4a
*.ogg
*.aac
!tests/fixtures/two_tone_test.wav
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx

# Pretrained models & trained binary checkpoints (downloaded automatically on first run)
models/*
!models/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# Datasets & local recordings (keep schema/docs without audio)
data/*
!data/.gitkeep
!data/real_eval/
data/real_eval/*
!data/real_eval/RECORDING_GUIDE.md
!data/real_eval/manifest.json

# Large generated evaluation output (keep committed aggregate summaries)
evaluation/results.json
!evaluation/public_summary.json
!evaluation/product_benchmarks.json
!evaluation/separation_results.json
!evaluation/efficiency_profile.json
