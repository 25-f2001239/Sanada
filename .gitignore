# Virtual environments
.venv/
venv/
env/

# Python caches, test & lint caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.pip-cache/
.pip-tmp/

# Node & IDEs
node_modules/
.idea/
.vscode/

# OS & logs
.DS_Store
Thumbs.db
*.log

# Secrets & environment (keep .env.example)
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
secrets.json

# Runtime uploads, temp, work, outputs, screenshots & archives
uploads/
user_uploads/
jobs/
tmp/
temp/
work/
feature_cache/
deliverables/
dist/
build/
.cache/
outputs/
screenshots/
playwright-report/
test-results/
backup-*/
cleanup-trash/
*.zip
*.7z
*.tar.gz
*.bak
*.orig
*.dump
*.db
*.sqlite
*.sqlite3
*.db-*
*.sqlite-*
*.sqlite3-*
instance/
data/.secret_key
data/ground_truth_index.json

# Pretrained models & trained binary checkpoints (downloaded automatically on first run)
models/*
!models/.gitkeep
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.ckpt
checkpoints/*.bin
checkpoints/*.safetensors
checkpoints/*.onnx
!checkpoints/.gitkeep

# Datasets & local recordings (keep schema/docs without audio)
data/*
!data/.gitkeep
!data/real_eval/
data/real_eval/*.wav
data/real_eval/*.flac
data/real_eval/*.mp3
!data/real_eval/RECORDING_GUIDE.md
!data/real_eval/manifest.json

# Large generated evaluation output (keep committed aggregate summaries)
evaluation/results.json
!evaluation/public_summary.json
!evaluation/product_benchmarks.json
!evaluation/separation_results.json
